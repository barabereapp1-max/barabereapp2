rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Helpers
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isEmailAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'barabereapp1@gmail.com';
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isOwnerOrAdmin(ownerUid) {
      return isVerifiedUser() && (ownerUid == request.auth.uid || isEmailAdmin());
    }

    // ---------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // ---------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'workshopName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'workshopName', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role in ['admin', 'cashier']
        && data.workshopName is string && data.workshopName.size() >= 2 && data.workshopName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSparePart(data) {
      return data.keys().hasAll(['ownerId', 'sku', 'name', 'category', 'brand', 'unit', 'buyPrice', 'sellPrice', 'stock', 'minStock', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'sku', 'name', 'category', 'brand', 'unit', 'buyPrice', 'sellPrice', 'stock', 'minStock', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 40
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.category in ['Oli & Pelumas', 'Rem & Kampas', 'Ban & Velg', 'Mesin & CVT', 'Kelistrikan', 'Aksesoris', 'Lainnya']
        && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 60
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20
        && data.buyPrice is number && data.buyPrice >= 0 && data.buyPrice <= 1000000000
        && data.sellPrice is number && data.sellPrice >= 0 && data.sellPrice <= 1000000000
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && data.minStock is number && data.minStock >= 0 && data.minStock <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['ownerId', 'name', 'phone', 'plateNumber', 'vehicleModel', 'totalVisits', 'totalSpent', 'lastVisitAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'phone', 'plateNumber', 'vehicleModel', 'totalVisits', 'totalSpent', 'lastVisitAt', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 24
        && data.plateNumber is string && data.plateNumber.size() >= 2 && data.plateNumber.size() <= 20
        && data.vehicleModel is string && data.vehicleModel.size() >= 2 && data.vehicleModel.size() <= 80
        && data.totalVisits is number && data.totalVisits >= 0 && data.totalVisits <= 100000
        && data.totalSpent is number && data.totalSpent >= 0 && data.totalSpent <= 100000000000
        && data.lastVisitAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['ownerId', 'invoiceNumber', 'customerId', 'customerName', 'plateNumber', 'vehicleModel', 'mechanicName', 'paymentMethod', 'status', 'subtotalParts', 'serviceFee', 'discount', 'totalAmount', 'itemsCount', 'itemSummary', 'notes', 'transactionDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'invoiceNumber', 'customerId', 'customerName', 'plateNumber', 'vehicleModel', 'mechanicName', 'paymentMethod', 'status', 'subtotalParts', 'serviceFee', 'discount', 'totalAmount', 'itemsCount', 'itemSummary', 'notes', 'transactionDate', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 4 && data.invoiceNumber.size() <= 40
        && isValidId(data.customerId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.plateNumber is string && data.plateNumber.size() >= 2 && data.plateNumber.size() <= 20
        && data.vehicleModel is string && data.vehicleModel.size() >= 2 && data.vehicleModel.size() <= 80
        && data.mechanicName is string && data.mechanicName.size() >= 2 && data.mechanicName.size() <= 80
        && data.paymentMethod in ['Tunai', 'QRIS', 'Transfer Bank', 'Kartu Debit']
        && data.status in ['Selesai', 'Batal']
        && data.subtotalParts is number && data.subtotalParts >= 0 && data.subtotalParts <= 10000000000
        && data.serviceFee is number && data.serviceFee >= 0 && data.serviceFee <= 10000000000
        && data.discount is number && data.discount >= 0 && data.discount <= 10000000000
        && data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 10000000000
        && data.itemsCount is number && data.itemsCount >= 0 && data.itemsCount <= 100
        && data.itemSummary is string && data.itemSummary.size() >= 1 && data.itemSummary.size() <= 500
        && data.notes is string && data.notes.size() <= 500
        && data.transactionDate is string && data.transactionDate.size() == 10 && data.transactionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransactionItem(data) {
      return data.keys().hasAll(['ownerId', 'transactionId', 'itemType', 'partId', 'name', 'qty', 'unitPrice', 'totalPrice'])
        && data.keys().hasOnly(['ownerId', 'transactionId', 'itemType', 'partId', 'name', 'qty', 'unitPrice', 'totalPrice'])
        && isValidId(data.ownerId)
        && isValidId(data.transactionId)
        && data.itemType in ['part', 'service']
        && data.partId is string && data.partId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.qty is number && data.qty > 0 && data.qty <= 10000
        && data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 1000000000
        && data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 10000000000;
    }

    function isValidServiceHistory(data) {
      return data.keys().hasAll(['ownerId', 'transactionId', 'invoiceNumber', 'customerId', 'customerName', 'plateNumber', 'vehicleModel', 'odometerKm', 'complaint', 'workSummary', 'mechanicName', 'totalCost', 'nextServiceNote', 'serviceDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'transactionId', 'invoiceNumber', 'customerId', 'customerName', 'plateNumber', 'vehicleModel', 'odometerKm', 'complaint', 'workSummary', 'mechanicName', 'totalCost', 'nextServiceNote', 'serviceDate', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.transactionId)
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 4 && data.invoiceNumber.size() <= 40
        && isValidId(data.customerId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.plateNumber is string && data.plateNumber.size() >= 2 && data.plateNumber.size() <= 20
        && data.vehicleModel is string && data.vehicleModel.size() >= 2 && data.vehicleModel.size() <= 80
        && data.odometerKm is number && data.odometerKm >= 0 && data.odometerKm <= 2000000
        && data.complaint is string && data.complaint.size() <= 500
        && data.workSummary is string && data.workSummary.size() >= 2 && data.workSummary.size() <= 500
        && data.mechanicName is string && data.mechanicName.size() >= 2 && data.mechanicName.size() <= 80
        && data.totalCost is number && data.totalCost >= 0 && data.totalCost <= 10000000000
        && data.nextServiceNote is string && data.nextServiceNote.size() <= 200
        && data.serviceDate is string && data.serviceDate.size() == 10 && data.serviceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection Rules
    // ---------------------------------------------------------

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isEmailAdmin());
      allow list: if isEmailAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'cashier' || (incoming().role == 'admin' && isEmailAdmin()));
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'workshopName', 'updatedAt'])) ||
          (isEmailAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'workshopName', 'role', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isEmailAdmin();
    }

    match /spareParts/{partId} {
      allow get: if isValidId(partId) && isOwnerOrAdmin(existing().ownerId);
      allow list: if isOwnerOrAdmin(existing().ownerId);
      allow create: if isValidId(partId)
        && isVerifiedUser()
        && isValidSparePart(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(partId)
        && isOwnerOrAdmin(existing().ownerId)
        && isValidSparePart(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['sku', 'name', 'category', 'brand', 'unit', 'buyPrice', 'sellPrice', 'stock', 'minStock', 'updatedAt'])
        );
      allow delete: if isValidId(partId) && isOwnerOrAdmin(existing().ownerId);
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId) && isOwnerOrAdmin(existing().ownerId);
      allow list: if isOwnerOrAdmin(existing().ownerId);
      allow create: if isValidId(customerId)
        && isVerifiedUser()
        && isValidCustomer(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(customerId)
        && isOwnerOrAdmin(existing().ownerId)
        && isValidCustomer(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['totalVisits', 'totalSpent', 'lastVisitAt', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'plateNumber', 'vehicleModel', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'plateNumber', 'vehicleModel', 'totalVisits', 'totalSpent', 'lastVisitAt', 'updatedAt'])
        );
      allow delete: if isValidId(customerId) && isOwnerOrAdmin(existing().ownerId);
    }

    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isOwnerOrAdmin(existing().ownerId);
      allow list: if isOwnerOrAdmin(existing().ownerId);
      allow create: if isValidId(transactionId)
        && isVerifiedUser()
        && isValidTransaction(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'Selesai'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/customers/$(incoming().customerId));
      allow update: if isValidId(transactionId)
        && isOwnerOrAdmin(existing().ownerId)
        && isValidTransaction(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
        && (
          isEmailAdmin() ||
          (existing().status == 'Selesai' && incoming().status == 'Batal')
        );
      allow delete: if isValidId(transactionId) && isEmailAdmin();

      match /items/{itemId} {
        allow get: if isValidId(transactionId) && isValidId(itemId) && isOwnerOrAdmin(get(/databases/$(database)/documents/transactions/$(transactionId)).data.ownerId);
        allow list: if isOwnerOrAdmin(existing().ownerId);
        allow create: if isValidId(transactionId)
          && isValidId(itemId)
          && isVerifiedUser()
          && isValidTransactionItem(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().transactionId == transactionId
          && getAfter(/databases/$(database)/documents/transactions/$(transactionId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(transactionId)
          && isValidId(itemId)
          && isEmailAdmin()
          && isValidTransactionItem(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().transactionId == existing().transactionId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'qty', 'unitPrice', 'totalPrice']);
        allow delete: if isValidId(transactionId) && isValidId(itemId) && isEmailAdmin();
      }
    }

    match /serviceHistories/{historyId} {
      allow get: if isValidId(historyId) && isOwnerOrAdmin(existing().ownerId);
      allow list: if isOwnerOrAdmin(existing().ownerId);
      allow create: if isValidId(historyId)
        && isVerifiedUser()
        && isValidServiceHistory(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/transactions/$(incoming().transactionId))
        && existsAfter(/databases/$(database)/documents/customers/$(incoming().customerId));
      allow update: if isValidId(historyId)
        && isOwnerOrAdmin(existing().ownerId)
        && isValidServiceHistory(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().transactionId == existing().transactionId
        && incoming().customerId == existing().customerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['odometerKm', 'complaint', 'workSummary', 'nextServiceNote', 'updatedAt']);
      allow delete: if isValidId(historyId) && isOwnerOrAdmin(existing().ownerId);
    }
  }
}
