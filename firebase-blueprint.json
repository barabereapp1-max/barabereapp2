{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna kasir atau admin bengkel yang terautentikasi via Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID pengguna.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Nama tampilan pengguna.",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Alamat email Google terverifikasi.",
          "minLength": 3,
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "description": "URL foto profil Google.",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["admin", "cashier"],
          "description": "Peran akses pengguna dalam aplikasi."
        },
        "workshopName": {
          "type": "string",
          "description": "Nama bengkel yang dikelola.",
          "minLength": 2,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan profil."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan terakhir."
        }
      },
      "required": ["uid", "displayName", "email", "role", "workshopName", "createdAt", "updatedAt"]
    },
    "SparePart": {
      "title": "SparePart",
      "description": "Data inventaris dan stok suku cadang bengkel.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID pemilik/kasir pembuat data.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "description": "Kode unik suku cadang.",
          "minLength": 2,
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap suku cadang.",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["Oli & Pelumas", "Rem & Kampas", "Ban & Velg", "Mesin & CVT", "Kelistrikan", "Aksesoris", "Lainnya"],
          "description": "Kategori suku cadang."
        },
        "brand": {
          "type": "string",
          "description": "Merek pabrikan suku cadang.",
          "minLength": 1,
          "maxLength": 60
        },
        "unit": {
          "type": "string",
          "description": "Satuan stok (Botol, Pcs, Set, Unit).",
          "minLength": 1,
          "maxLength": 20
        },
        "buyPrice": {
          "type": "number",
          "description": "Harga modal beli dalam Rupiah."
        },
        "sellPrice": {
          "type": "number",
          "description": "Harga jual ke pelanggan dalam Rupiah."
        },
        "stock": {
          "type": "number",
          "description": "Jumlah stok tersedia saat ini."
        },
        "minStock": {
          "type": "number",
          "description": "Batas minimum peringatan stok menipis."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu data dibuat."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu stok atau harga diperbarui."
        }
      },
      "required": ["ownerId", "sku", "name", "category", "brand", "unit", "buyPrice", "sellPrice", "stock", "minStock", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Data pelanggan dan kendaraan yang diservis di bengkel.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID pemilik/kasir pengelola.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap pelanggan.",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Nomor telepon atau WhatsApp pelanggan.",
          "minLength": 5,
          "maxLength": 24
        },
        "plateNumber": {
          "type": "string",
          "description": "Nomor polisi kendaraan.",
          "minLength": 2,
          "maxLength": 20
        },
        "vehicleModel": {
          "type": "string",
          "description": "Tipe dan tahun kendaraan.",
          "minLength": 2,
          "maxLength": 80
        },
        "totalVisits": {
          "type": "number",
          "description": "Total kunjungan servis."
        },
        "totalSpent": {
          "type": "number",
          "description": "Akumulasi total belanja perbaikan."
        },
        "lastVisitAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu kunjungan servis terakhir."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pendaftaran pelanggan."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan terakhir."
        }
      },
      "required": ["ownerId", "name", "phone", "plateNumber", "vehicleModel", "totalVisits", "totalSpent", "lastVisitAt", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Nota transaksi kasir bengkel untuk suku cadang dan jasa servis.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID kasir/pemilik yang mencatat transaksi.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Nomor invoice unik.",
          "minLength": 4,
          "maxLength": 40
        },
        "customerId": {
          "type": "string",
          "description": "ID dokumen pelanggan.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "description": "Nama pelanggan pada saat transaksi.",
          "minLength": 2,
          "maxLength": 100
        },
        "plateNumber": {
          "type": "string",
          "description": "Nomor polisi kendaraan.",
          "minLength": 2,
          "maxLength": 20
        },
        "vehicleModel": {
          "type": "string",
          "description": "Model kendaraan.",
          "minLength": 2,
          "maxLength": 80
        },
        "mechanicName": {
          "type": "string",
          "description": "Nama mekanik penanggung jawab.",
          "minLength": 2,
          "maxLength": 80
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Tunai", "QRIS", "Transfer Bank", "Kartu Debit"],
          "description": "Metode pembayaran yang digunakan."
        },
        "status": {
          "type": "string",
          "enum": ["Selesai", "Batal"],
          "description": "Status final transaksi."
        },
        "subtotalParts": {
          "type": "number",
          "description": "Total harga suku cadang."
        },
        "serviceFee": {
          "type": "number",
          "description": "Total biaya jasa perbaikan."
        },
        "discount": {
          "type": "number",
          "description": "Potongan harga dalam Rupiah."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total akhir transaksi yang dibayar."
        },
        "itemsCount": {
          "type": "number",
          "description": "Jumlah baris item dalam transaksi."
        },
        "itemSummary": {
          "type": "string",
          "description": "Ringkasan teks item suku cadang dan jasa.",
          "minLength": 1,
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "description": "Catatan tambahan nota.",
          "maxLength": 500
        },
        "transactionDate": {
          "type": "string",
          "description": "Tanggal lokal transaksi format YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp transaksi."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan transaksi."
        }
      },
      "required": ["ownerId", "invoiceNumber", "customerId", "customerName", "plateNumber", "vehicleModel", "mechanicName", "paymentMethod", "status", "subtotalParts", "serviceFee", "discount", "totalAmount", "itemsCount", "itemSummary", "notes", "transactionDate", "createdAt", "updatedAt"]
    },
    "TransactionItem": {
      "title": "TransactionItem",
      "description": "Subkoleksi rincian item suku cadang atau jasa dalam sebuah transaksi.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID kasir/pemilik.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "transactionId": {
          "type": "string",
          "description": "ID dokumen induk transaksi.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "enum": ["part", "service"],
          "description": "Jenis item: suku cadang atau jasa."
        },
        "partId": {
          "type": "string",
          "description": "ID suku cadang jika bertipe part.",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Nama suku cadang atau deskripsi jasa.",
          "minLength": 1,
          "maxLength": 120
        },
        "qty": {
          "type": "number",
          "description": "Kuantitas."
        },
        "unitPrice": {
          "type": "number",
          "description": "Harga satuan."
        },
        "totalPrice": {
          "type": "number",
          "description": "Subtotal item (qty * unitPrice)."
        }
      },
      "required": ["ownerId", "transactionId", "itemType", "partId", "name", "qty", "unitPrice", "totalPrice"]
    },
    "ServiceHistory": {
      "title": "ServiceHistory",
      "description": "Catatan riwayat perbaikan pelanggan yang terbuat otomatis saat checkout kasir.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID kasir/pemilik.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "transactionId": {
          "type": "string",
          "description": "ID transaksi terkait.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Nomor invoice transaksi terkait.",
          "minLength": 4,
          "maxLength": 40
        },
        "customerId": {
          "type": "string",
          "description": "ID dokumen pelanggan.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "description": "Nama pelanggan.",
          "minLength": 2,
          "maxLength": 100
        },
        "plateNumber": {
          "type": "string",
          "description": "Nomor polisi kendaraan.",
          "minLength": 2,
          "maxLength": 20
        },
        "vehicleModel": {
          "type": "string",
          "description": "Model kendaraan.",
          "minLength": 2,
          "maxLength": 80
        },
        "odometerKm": {
          "type": "number",
          "description": "Angka kilometer kendaraan saat servis."
        },
        "complaint": {
          "type": "string",
          "description": "Keluhan awal pelanggan.",
          "maxLength": 500
        },
        "workSummary": {
          "type": "string",
          "description": "Rangkuman pekerjaan perbaikan dan penggantian suku cadang.",
          "minLength": 2,
          "maxLength": 500
        },
        "mechanicName": {
          "type": "string",
          "description": "Nama mekanik yang menangani.",
          "minLength": 2,
          "maxLength": 80
        },
        "totalCost": {
          "type": "number",
          "description": "Total biaya perbaikan."
        },
        "nextServiceNote": {
          "type": "string",
          "description": "Rekomendasi jadwal servis berikutnya.",
          "maxLength": 200
        },
        "serviceDate": {
          "type": "string",
          "description": "Tanggal servis format YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pencatatan."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan catatan."
        }
      },
      "required": ["ownerId", "transactionId", "invoiceNumber", "customerId", "customerName", "plateNumber", "vehicleModel", "odometerKm", "complaint", "workSummary", "mechanicName", "totalCost", "nextServiceNote", "serviceDate", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profil pengguna terautentikasi dan peran bengkel (PII terlindungi)."
    },
    "/spareParts/{partId}": {
      "schema": { "$ref": "#/entities/SparePart" },
      "description": "Katalog stok suku cadang bengkel."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Master data pelanggan dan kendaraan."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Catatan transaksi pembayaran kasir bengkel."
    },
    "/transactions/{transactionId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/TransactionItem" },
      "description": "Subkoleksi rincian item suku cadang dan jasa tiap transaksi."
    },
    "/serviceHistories/{historyId}": {
      "schema": { "$ref": "#/entities/ServiceHistory" },
      "description": "Riwayat perbaikan kendaraan pelanggan yang tercatat otomatis."
    }
  }
}
